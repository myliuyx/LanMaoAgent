# Database Configuration (Required / 必填)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db
DB_USER=stock_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration (Required / 必填)
# Must be at least 32 characters / 至少32字符
JWT_SECRET_KEY=your_secret_key_at_least_32_characters_here

# Optional / 可选配置
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_HOURS=24

# CORS Configuration (comma-separated origins, empty to disable)
# CORS_ORIGINS=http://localhost:5173,https://example.com